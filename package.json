{
  "name": "fe_architecture",
  "version": "1.0.0",
  "description": "Example of how we could inject different technologies component",
  "main": "index.js",
  "scripts": {
    "test": "cd test && jest --no-cache  --collect-coverage --env=jsdom",
    "start": "cp src/index.html dist/ && webpack-dev-server --env development",
    "build": "tsc && webpack --env production",
    "all": "npm run build && npm run start",
    "clean": "rm -rf dist/"
  },
  "author": "Marco Sabatini",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "27.0.2",
    "jest": "27.2.5",
    "ts-jest": "27.0.5",
    "typescript": "^4.4.3",
    "webpack": "^5.58.1",
    "webpack-cli": "^4.9.0",
    "webpack-dev-server": "^4.3.1"
  },
  "dependencies": {
    "babel-core": "^6.26.3",
    "babel-loader": "^8.2.2",
    "babel-preset-es2015": "^6.24.1",
    "babel-preset-react": "^6.24.1",
    "babel-preset-stage-0": "^6.24.1",
    "css-loader": "^3.6.0",
    "bootstrap": "^5.1.3",
    "style-loader": "^3.3.0",
    "ts-loader": "^9.2.6"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": "./node_modules/ts-jest"
    },
    "testMatch": [
      "**/*Test.(ts|tsx)"
    ]
  },
  "presets": [
    "@babel/preset-env",
    "@babel/preset-react"
  ]
}
