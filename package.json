{
  "name": "fe_architecture",
  "version": "1.0.0",
  "description": "Example of how we could inject different technologies component",
  "main": "index.js",
  "scripts": {
    "test": "cd test && jest --no-cache  --collect-coverage --env=jsdom",
    "build": "tsc && webpack --env production && cp src/index.html dist/",
    "autoreload": "watch 'npm run build' js --interval=0.01",
    "clean": "rm -rf dist/"
  },
  "author": "Marco Sabatini",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "27.0.2",
    "jest": "27.2.5",
    "ts-jest": "27.0.5",
    "typescript": "4.4.4",
    "webpack": "5.58.2",
    "webpack-cli": "4.9.0"
  },
  "dependencies": {
    "babel-core": "6.26.3",
    "babel-loader": "8.2.2",
    "babel-preset-es2015": "6.24.1",
    "babel-preset-stage-0": "6.24.1",
    "css-loader": "6.4.0",
    "bootstrap": "5.1.3",
    "style-loader": "3.3.0",
    "ts-loader": "9.2.6",
    "@popperjs/core": "2.10.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "transform": {
      "^.+\\.(ts)$": "./node_modules/ts-jest"
    },
    "testMatch": [
      "**/*Test.(ts)"
    ]
  },
  "presets": [
    "@babel/preset-env"
  ]
}
