{
  "compilerOptions": { 
    "target": "ES6",
    "module": "es6", 
    "moduleResolution": "node", 
    "lib": ["es6", "dom"],
    "strict": true,
    "noImplicitReturns": true,
    "rootDir": "src",
    "outDir": "dist",
    "allowJs": true,
    "esModuleInterop": true
  },
  "include": ["**/*.ts", "**/*.tsx","./src"],
  "exclude": ["node_modules","test"]
}
